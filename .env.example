# Copy to .env for local development. Use a secret store in deployed services.
# Generate a 32-byte random key; store its SHA-256 digest in the JSON mapping.
# The service returns 503 for document routes until valid credentials are set.
INGESTION_API_KEY_SHA256_JSON={}
INGESTION_OUTPUT_DIR=./output
# Local policy; set true in production alongside a separately configured encrypted backup job.
# This flag does not create or encrypt backups by itself.
ENCRYPTED_BACKUPS=false
# Synchronous/legacy and server-directory routes are intentionally unavailable.
ENABLE_SYNC_EXTRACTION=false
ENABLE_LANGGRAPH_ENGINE=false
# Opt-in, admin-only durable Temporal/LangGraph test lane. Requires the
# Temporal server and CPU/GPU activity workers to be running.
ENABLE_TEMPORAL_TEST_LANE=false
# Tune only after reviewing production-host load evidence; all values have hard code ceilings.
INGESTION_MAX_PENDING_JOBS=8
INGESTION_MAX_TENANT_JOBS=4
INGESTION_MAX_PENDING_BYTES=125829120
INGESTION_MAX_TENANT_BYTES=62914560
INGESTION_MAX_SUBMISSIONS_PER_MINUTE=100
INGESTION_MAX_TENANT_SUBMISSIONS_PER_MINUTE=20
# Optional LayoutReader must use a verified absolute local directory if enabled.
# LAYOUTREADER_MODEL_DIR=/absolute/path/to/verified/layoutreader
# --- VLM provider layer (test lane only; no workload reaches VLM calls today) ---
# Default provider for VLM calls (review drafting, Phase 05 challenger).
# VLM_PROVIDER=ollama
# VLM_MODEL=gemma4:31b-cloud
OLLAMA_HOST=http://127.0.0.1:11434
# Note: `-cloud` Ollama models route through ollama.com, so they are hosted
# inference for data-handling purposes even though the API is local.
# Select a local model when processing documents that must stay local.
# OPENAI_API_KEY=...
# GEMINI_API_KEY=...
# VLM_TIMEOUT_SECONDS=180
# Runner CLI used by scripts/prepare_vlm_review.py: scripts/vlm_runner

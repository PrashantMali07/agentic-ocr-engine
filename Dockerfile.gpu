# GPU Multi-stage build for Azure Container Apps / NVIDIA GPUs
# Stage 1: Build dependencies
FROM nvidia/cuda:12.3.0-devel-ubuntu22.04@sha256:10aee9352d37507f233317d19feb6f39ad3d909189fe56c8b3d56ec27ab12204 AS builder

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install Python 3.11 and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    curl \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-distutils \
    gcc \
    g++ \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --set python3 /usr/bin/python3.11

# Install UV for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:0.12.10@sha256:2bb3ebca0a796a155094a27773d290c4b074572e6107f171d88d086682fd2500 /uv /usr/local/bin/uv

WORKDIR /app

# Cloud builds (ACR) need a long timeout for the large paddlepaddle-gpu wheel.
ENV UV_HTTP_TIMEOUT=600
ENV UV_CONCURRENT_DOWNLOADS=2

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies in virtual environment (this is your real GPU env — untouched)
RUN uv sync --frozen --no-dev --no-install-project

# Pre-download PP-StructureV3 models using a disposable CPU-only paddle env.
# This avoids importing GPU paddle at build time (no libcuda.so.1 available in
# `docker build`), while still populating the model cache that PPStructureV3
# reads from PaddleX (~/.paddlex/official_models), which gets copied into the
# runtime image below.
# Use a script (not inline python -c) so Azure ACR dependency scanning can parse this file.
COPY requirements-cpu.lock model-artifacts.json ./
COPY scripts/prefetch_models.py /tmp/prefetch_models.py
COPY src/ingestion_pipeline/model_artifacts.py /tmp/model_artifacts.py
RUN uv venv /tmp/model-download-env --python 3.11 \
    && uv pip sync --python /tmp/model-download-env/bin/python --require-hashes requirements-cpu.lock \
    && /tmp/model-download-env/bin/python /tmp/prefetch_models.py \
    && /tmp/model-download-env/bin/python /tmp/model_artifacts.py verify --root /root/.paddlex/official_models --manifest /app/model-artifacts.json \
    && rm -rf /tmp/model-download-env /tmp/prefetch_models.py /tmp/model_artifacts.py

# Stage 2: Runtime
FROM nvidia/cuda:12.3.0-runtime-ubuntu22.04@sha256:1885bd2266e81ff1e9034598b8edf2ae0cd485d9339cf7b3902f442ce96c9ac8 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Install Python 3.11 and runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    curl \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-distutils \
    # For PDF processing
    poppler-utils \
    # For image processing/OpenCV (libgl1 replaces obsolete libgl1-mesa-glx)
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    # For OCR
    tesseract-ocr \
    libtesseract-dev \
    # cuDNN runtime lib required by paddlepaddle-gpu (CUDA 12.3)
    libcudnn8 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set Python 3.11 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --set python3 /usr/bin/python3.11

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Copy pre-downloaded models — PaddleX cache dir, not .paddleocr
COPY --from=builder /root/.paddlex/official_models /home/appuser/.paddlex/official_models
COPY --from=builder /app/model-artifacts.json /app/model-artifacts.json

# Copy application code
COPY src/ ./src/
COPY pyproject.toml ./

# Create directories for temp files and output
RUN mkdir -p /tmp/ingestion /app/output /app/logs && \
    chown -R appuser:appuser /app/output /app/logs /tmp/ingestion && \
    chown appuser:appuser /home/appuser && \
    chmod -R a-w /home/appuser/.paddlex/official_models && \
    chmod 700 /app/output /app/logs /tmp/ingestion

# Switch to non-root user
USER appuser

# Set Python path and Environment
ENV PYTHONPATH=/app/src
ENV PATH="/app/.venv/bin:$PATH"
ENV HOME=/home/appuser
ENV OCR_MODEL_ROOT=/home/appuser/.paddlex/official_models
ENV OCR_MODEL_MANIFEST=/app/model-artifacts.json
ENV PORT=8000
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV INGESTION_OUTPUT_DIR=/app/output
ENV INGESTION_INPUT_DIR=/app/output/input

# GPU Configuration
ENV PADDLE_USE_GPU=true
ENV USE_TENSORRT=false
ENV USE_ONNX=false

# Healthcheck for local docker only. ACA overrides with HTTP /health startup probe
# (GPU cold start can take several minutes — keep start-period long).
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=10 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5)" || exit 1

EXPOSE 8000

# Run the application
CMD ["python3", "-m", "ingestion_pipeline.api"]
